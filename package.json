{
  "name": "recipe-dost",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.12",
    "expo-application": "^56.0.3",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.21",
    "expo-device": "^56.0.4",
    "expo-file-system": "^56.0.8",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-share-intent": "^7.0.0",
    "expo-sharing": "~56.0.18",
    "expo-splash-screen": "~56.0.11",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.3.1",
    "posthog-react-native": "^4.50.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-purchases": "^10.4.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.19.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:android": "node scripts/env/run-with-env.mjs development -- npx expo start --dev-client --clear",
    "typecheck": "tsc --noEmit",
    "expo:config": "npx expo config --json >/dev/null",
    "qa:guards": "node scripts/qa-static-guards.mjs",
    "qa:static": "npm run typecheck && npm run expo:config && npm run qa:guards",
    "env:validate:dev": "node scripts/env/validate-env.mjs development",
    "env:validate:prod": "node scripts/env/validate-env.mjs production",
    "env:eas:dev:dry": "node scripts/env/sync-eas-env.mjs development --dry-run",
    "env:eas:prod:dry": "node scripts/env/sync-eas-env.mjs production --dry-run",
    "env:supabase:dev:dry": "node scripts/env/sync-supabase-secrets.mjs development --dry-run",
    "env:supabase:prod:dry": "node scripts/env/sync-supabase-secrets.mjs production --dry-run",
    "env:deploy:dev": "node scripts/env/deploy-app-env.mjs development --apply",
    "env:deploy:prod": "node scripts/env/deploy-app-env.mjs production --apply",
    "env:check": "node scripts/env/validate-env.mjs development --example && node scripts/env/validate-env.mjs production --example",
    "build:dev": "node scripts/env/build-app.mjs development development",
    "build:preview": "node scripts/env/build-app.mjs development preview",
    "build:prod:dry": "node scripts/env/deploy-app-env.mjs production --dry-run",
    "build:prod": "node scripts/env/build-app.mjs production production",
    "doctor": "expo-doctor",
    "doctor:verbose": "expo-doctor --verbose",
    "functions:check": "deno check --config supabase/functions/generate-card/deno.json supabase/functions/generate-card/index.ts && deno check --config supabase/functions/parse-url/deno.json supabase/functions/parse-url/index.ts && deno check --config supabase/functions/save-recipe-link/deno.json supabase/functions/save-recipe-link/index.ts && deno check --config supabase/functions/refresh-recipe-metadata/deno.json supabase/functions/refresh-recipe-metadata/index.ts && deno check --config supabase/functions/create-media-job/deno.json supabase/functions/create-media-job/index.ts && deno check --config supabase/functions/get-ai-access/deno.json supabase/functions/get-ai-access/index.ts && deno check --config supabase/functions/sync-revenuecat-entitlement/deno.json supabase/functions/sync-revenuecat-entitlement/index.ts",
    "functions:fmt": "deno fmt supabase/functions"
  },
  "private": true
}
