# Copy to env/production.env and fill with production values.
APP_ENV=production
APP_VARIANT=production

# EAS public/app variables. EXPO_PUBLIC values are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_SUPABASE_ANON_KEY
# Production must use the real RevenueCat Android public SDK key, not a Test Store key.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=YOUR_PROD_REVENUECAT_ANDROID_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
EXPO_PUBLIC_SENTRY_DSN=YOUR_PROD_SENTRY_DSN
EXPO_PUBLIC_SENTRY_DEV_TEST=false
EXPO_PUBLIC_POSTHOG_API_KEY=YOUR_PROD_POSTHOG_PROJECT_TOKEN
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_DEV_TEST=false

# EAS production build metadata for Sentry source-map upload. Keep the auth token
# in EAS as a secret; it is build-only and must never use an EXPO_PUBLIC_ prefix.
SENTRY_ORG=YOUR_SENTRY_ORGANIZATION_SLUG
SENTRY_PROJECT=YOUR_SENTRY_PROJECT_SLUG
SENTRY_AUTH_TOKEN=YOUR_SENTRY_BUILD_AUTH_TOKEN

# Supabase target and required Edge Function secrets. Never expose these with EXPO_PUBLIC_.
SUPABASE_PROJECT_REF=YOUR_PROD_PROJECT_REF
SUPABASE_ENV_NAME=production
REVENUECAT_API_KEY=YOUR_PROD_REVENUECAT_SECRET_API_KEY
REVENUECAT_ENTITLEMENT_ID=premium
MEDIA_WORKER_URL=https://YOUR_PROD_WORKER.example.com
MEDIA_WORKER_SHARED_SECRET=YOUR_PROD_MEDIA_WORKER_SHARED_SECRET

# Optional Edge Function secrets/config. Uncomment only when this environment uses them.
# GEMINI_API_KEY=YOUR_PROD_GEMINI_API_KEY
# OPENAI_API_KEY=YOUR_PROD_OPENAI_API_KEY
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VIDEO_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4o-mini
# MAX_INPUT_CHARS=12000
# FREE_AI_GENERATION_LIMIT=3
# MEDIA_PROCESSOR_MODE=queue
# WORKER_WAKE_TIMEOUT_MS=2500
# METADATA_PREVIEW_TIMEOUT_MS=25000
