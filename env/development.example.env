# Copy to env/development.env and fill with development values.
APP_ENV=development
APP_VARIANT=development

# EAS public/app variables. EXPO_PUBLIC values are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_SUPABASE_ANON_KEY
# Development may use a RevenueCat Test Store key for local/Test Store testing only.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=YOUR_DEV_REVENUECAT_ANDROID_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default

# Supabase target and required Edge Function secrets. Never expose these with EXPO_PUBLIC_.
SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF
SUPABASE_ENV_NAME=development
REVENUECAT_API_KEY=YOUR_DEV_REVENUECAT_SECRET_API_KEY
REVENUECAT_ENTITLEMENT_ID=premium
MEDIA_WORKER_URL=https://YOUR_DEV_WORKER.example.com
MEDIA_WORKER_SHARED_SECRET=YOUR_DEV_MEDIA_WORKER_SHARED_SECRET

# Optional Edge Function secrets/config. Uncomment only when this environment uses them.
# GEMINI_API_KEY=YOUR_DEV_GEMINI_API_KEY
# OPENAI_API_KEY=YOUR_DEV_OPENAI_API_KEY
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_VIDEO_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4o-mini
# MAX_INPUT_CHARS=12000
# FREE_AI_GENERATION_LIMIT=3
# MEDIA_PROCESSOR_MODE=queue
# WORKER_WAKE_TIMEOUT_MS=2500
# METADATA_PREVIEW_TIMEOUT_MS=25000
